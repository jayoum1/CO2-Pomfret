# Local development environment variables for the CO2 Pomfret backend.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Loaded automatically by src/api/app.py at startup when python-dotenv is
# installed (it's in requirements.txt). Production deployments should inject
# these through their platform instead of committing them anywhere.
#
# IMPORTANT: never paste service-account JSON content into this file or any
# frontend env. Always point CO2_SHEETS_CREDENTIALS_FILE at a local path.

# ----------------------------------------------------------------------------
# Admin token — required for /admin/* HTTP routes unless CO2_DISABLE_ADMIN_AUTH
# is set (local dev only — never in production).
# ----------------------------------------------------------------------------
CO2_ADMIN_TOKEN=change-me-to-a-long-random-string

# Set to false in normal development; use true only on your own machine.
CO2_DISABLE_ADMIN_AUTH=false

# For local testing only (never deploy with this):
# CO2_DISABLE_ADMIN_AUTH=true

# ----------------------------------------------------------------------------
# Google Sheets source (Phase 1/2 preview + publish pipeline)
# ----------------------------------------------------------------------------
CO2_SHEETS_SPREADSHEET_ID=your-google-sheet-id-here

# Tab names — default to Lower/Middle/Upper. Override if your sheet uses
# different tab labels (e.g. "Lower Plot 2026").
CO2_SHEETS_TAB_LOWER=Lower
CO2_SHEETS_TAB_MIDDLE=Middle
CO2_SHEETS_TAB_UPPER=Upper

# Service-account credentials — point this at the JSON key downloaded from
# Google Cloud. Stays on the backend only; never exposed to the frontend.
CO2_SHEETS_CREDENTIALS_FILE=/absolute/path/to/secrets/google-service-account.json

# Alternative: paste the JSON content directly (single line). Useful in CI.
# Leave unset if you use CO2_SHEETS_CREDENTIALS_FILE above.
# CO2_SHEETS_CREDENTIALS_JSON={"type":"service_account",...}

# Public CSV fallback — set to "true" to skip service-account auth and read
# via the public CSV-export URL (sheet must be shared "Anyone with the link
# can view"). Easiest for a one-off smoke test.
# CO2_SHEETS_PUBLIC_CSV=true
